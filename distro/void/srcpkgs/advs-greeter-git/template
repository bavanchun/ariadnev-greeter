# Template file for 'advs-greeter-git'
#
# Git snapshot of ADVS Greeter. Built by CI: the workflow stages a flat local
# source tarball (create_wrksrc=yes) and patches version/checksum/distfiles.
pkgname=advs-greeter-git
version=1.0.0.git
revision=1
create_wrksrc=yes
build_wrksrc="core"
build_style=go
hostmakedepends="make tar"
go_import_path="github.com/bavanchun/ariadnev-greeter/core"
go_package="${go_import_path}/cmd/advs-greeter"
go_build_tags="withshell"
go_ldflags="-X main.Version=${version}"
short_desc="Greetd login screen with the Adv Material aesthetic (git)"
maintainer="bavanchun <bavanchun.US@gmail.com>"
license="MIT"
homepage="https://github.com/bavanchun/ariadnev-greeter"
# CI populates distfiles/checksum dynamically; these are placeholders.
distfiles="https://github.com/bavanchun/ariadnev-greeter/archive/refs/heads/master.tar.gz"
checksum=badbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadb

conflicts="advs-greeter"
provides="advs-greeter-${version}_${revision}"

depends="greetd quickshell acl-progs dbus elogind pam_rundir mesa-dri"

make_dirs="/var/cache/advs-greeter 0750 _greeter _greeter"

pre_build() {
	make sync-shell
}

post_install() {
	vmkdir usr/share/bash-completion/completions
	vmkdir usr/share/zsh/site-functions
	vmkdir usr/share/fish/vendor_completions.d
	if [ -z "$CROSS_BUILD" ]; then
		"${DESTDIR}/usr/bin/advs-greeter" completion bash > "${DESTDIR}/usr/share/bash-completion/completions/advs-greeter"
		"${DESTDIR}/usr/bin/advs-greeter" completion zsh  > "${DESTDIR}/usr/share/zsh/site-functions/_advs-greeter"
		"${DESTDIR}/usr/bin/advs-greeter" completion fish > "${DESTDIR}/usr/share/fish/vendor_completions.d/advs-greeter.fish"
	fi

	vmkdir usr/share/examples/advs-greeter
	vcopy "${wrksrc}/assets/examples/*" usr/share/examples/advs-greeter

	vdoc "${wrksrc}/README.md"
	vlicense "${wrksrc}/LICENSE"
}
